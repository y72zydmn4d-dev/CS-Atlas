# Gemini API key from Google AI Studio. Copy this file to .env.local.
# Keep the key on the server; never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override; default is gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Remote Judge is deliberately not configured by this application. Do not add
# a sandbox URL or credential until the isolated-service security gates in
# docs/atlas-v2/08-online-judge-architecture.md have been completed.
